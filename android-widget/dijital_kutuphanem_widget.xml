<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bordeaux_background"
    android:padding="8dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_launcher"
            android:contentDescription="Logo" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="DİJİTAL KÜTÜPHANEM"
            android:textColor="#F5E6C8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✦ CANLI İLİM"
            android:textColor="#D8BA76"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#40B79A63" />

    <!-- 3 Equal Width Columns -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="6dp">

        <!-- 1. SÜTUN: KİTAP -->
        <LinearLayout
            android:id="@+id/col_kitap"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1. KİTAP"
                android:textColor="#E2C382"
                android:textSize="10sp"
                android:textStyle="bold" />

            <!-- Circular / Ring or Text Value -->
            <TextView
                android:id="@+id/txt_kitap_yuzde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%82"
                android:textColor="#FFF8E7"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_kitap_sayfa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33 / 40 syf"
                android:textColor="#FFFDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bugün"
                android:textColor="#B79A63"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Divider 1 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33B79A63" />

        <!-- 2. SÜTUN: KUR'AN -->
        <LinearLayout
            android:id="@+id/col_quran"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2. KUR'AN"
                android:textColor="#E2C382"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_quran_yuzde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%23"
                android:textColor="#A7F3D0"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_quran_hizb"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1 / 1 Hizb"
                android:textColor="#FFFDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kur'an-ı Kerim"
                android:textColor="#B79A63"
                android:textSize="8sp" />
        </LinearLayout>

        <!-- Divider 2 -->
        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#33B79A63" />

        <!-- 3. SÜTUN: İLİM YOLCULUĞUM -->
        <LinearLayout
            android:id="@+id/col_ilim"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3. İLİM"
                android:textColor="#E2C382"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_ilim_yuzde"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="%4.2"
                android:textColor="#FDE68A"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_ilim_eser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="6 Eser (4/ay)"
                android:textColor="#FFFDF8"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40 Yıl Müfredat"
                android:textColor="#B79A63"
                android:textSize="8sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
